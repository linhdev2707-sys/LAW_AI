# ====== Environment ======
NODE_ENV=development

# ====== Postgres ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lawai
POSTGRES_PASSWORD=lawai_password
POSTGRES_DB=law_ai
# Aliases for backend (read by @nestjs/config)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lawai
DATABASE_PASSWORD=lawai_password
DATABASE_NAME=law_ai

# ====== Backend ======
BACKEND_PORT=4000
BACKEND_CORS_ORIGIN=http://localhost:3000

# ====== Frontend ======
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====== NextAuth.js (FE) + JWT (BE) — MUST BE EQUAL ======
# Used by both NextAuth (FE) and passport-jwt (BE) for HS256 signing/verification
NEXTAUTH_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-secret-key-change-me-min-32-chars-bbbbbbb
JWT_REFRESH_EXPIRES_IN=7d

# ====== RAG retrieval tuning ======
# Cosine similarity floor (0-1). Chunks below this are dropped before
# slicing topK. 0.30 is a reasonable default for bge-m3 embeddings
# (Phase 2 lowered the floor from 0.35 because the reranker can rescue
# relevant-but-low-cosine chunks).
# Set to 0 to disable the filter.
RAG_MIN_COSINE_SCORE=0.30

# Comma-separated list of R2 bucket names the retriever is allowed to
# search. Empty = no filter (backward compatible). Used to prevent chat
# from pulling chunks from corpora ingested for a different purpose
# (e.g. an admin playground bucket).
RAG_ALLOWED_BUCKETS=

# Hierarchical chunker (Phase 1) — soft chunk size, hard cap, overlap.
RAG_CHUNK_SIZE=480
RAG_HARD_CHUNK_SIZE=720
RAG_CHUNK_OVERLAP=50

# Metadata enrichment — call DeepSeek to fill in fields the regex pass
# couldn't extract. Adds ~1-2s per document ingest. Default: enabled.
RAG_ENRICHER_USE_LLM=true

# ====== Embedding backend (Phase 1) ======
# 'local' (Xenova bge-m3, default — ~600MB downloaded on first boot) or
# 'cloudflare' (Workers AI @cf/baai/bge-m3, no local model, requires
# CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN).
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIM=1024
# Set true if switching to a non-M3 bge-* model that needs prefixes.
EMBEDDING_USE_PREFIX=false
# Optional — redirect the model cache (useful in Docker to persist across
# image rebuilds).
# EMBEDDING_CACHE_DIR=/var/cache/xenova
# Optional — Hugging Face mirror endpoint (e.g. hf-mirror.com in CN).
# HF_ENDPOINT=https://hf-mirror.com/

# ====== Reranker (Phase 2) ======
# Cross-encoder reranker. Improves Recall@5 by 15-25 points on legal
# benchmarks. Disabled by default to avoid the ~600MB model download
# on first boot; set RERANKER_ENABLED=true to turn on.
RERANKER_ENABLED=false
RERANKER_BACKEND=local            # 'local' (Xenova bge-reranker-v2-m3) or 'cohere'
RERANKER_MODEL=Xenova/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
# Only required when RERANKER_BACKEND=cohere
# COHERE_API_KEY=

# ====== Knowledge Graph (Phase 4) ======
# When ALL three are set, KgService connects to Neo4j and the agent
# `expandReferences` tool can run real Cypher queries. When unset,
# KgService runs in stub mode and the tool returns an empty result.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# ====== Observability (Phase 5) ======
# The backend already emits a single structured JSON line per HTTP
# request (kind: "http", requestId, method, url, status, durationMs,
# userId) — pipe stdout to Datadog/Elasticsearch/Loki for aggregation.
#
# Optional Sentry (uncomment + npm install @sentry/node to enable):
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production
