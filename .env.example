# ====== Environment ======
NODE_ENV=development

# ====== Postgres ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lawai
POSTGRES_PASSWORD=lawai_password
POSTGRES_DB=law_ai
# Aliases for backend (read by @nestjs/config)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lawai
DATABASE_PASSWORD=lawai_password
DATABASE_NAME=law_ai

# ====== Backend ======
BACKEND_PORT=4000
BACKEND_CORS_ORIGIN=http://localhost:3000

# ====== Frontend ======
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====== NextAuth.js (FE) + JWT (BE) — MUST BE EQUAL ======
# Used by both NextAuth (FE) and passport-jwt (BE) for HS256 signing/verification
NEXTAUTH_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-secret-key-change-me-min-32-chars-bbbbbbb
JWT_REFRESH_EXPIRES_IN=7d
