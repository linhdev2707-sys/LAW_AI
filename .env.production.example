# Production env vars for VPS deploy (ilaw.io.vn)
#
# File này KHÔNG chứa giá trị thật — nó là template để bạn biết cần
# set những gì trên VPS. Copy sang `.env.production` rồi điền giá trị
# thật (KHÔNG commit file đó).
#
# Generate strong secrets với:
#   openssl rand -hex 32     # 64 hex chars
#   openssl rand -base64 48  # 64 base64 chars

# ====== Server ======
NODE_ENV=production
BACKEND_PORT=4000
CORS_ORIGIN=https://ilaw.io.vn,https://www.ilaw.io.vn

# ====== PostgreSQL ======
POSTGRES_USER=lawai
POSTGRES_PASSWORD=<generate: openssl rand -hex 24>
POSTGRES_DB=law_ai
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=lawai
DATABASE_PASSWORD=<cùng giá trị với POSTGRES_PASSWORD>
DATABASE_NAME=law_ai

# ====== JWT (MUST match NEXTAUTH_SECRET on FE) ======
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_EXPIRES_IN=7d

# ====== LLM (DeepSeek) ======
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.3

# ====== OpenAI Embeddings ======
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ====== Cloudflare R2 ======
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_BUCKET_NAME=law-ai-rag
R2_REGION=auto
R2_ENDPOINT=

# ====== OCR (Cloudflare Workers AI) ======
# CÙNG giá trị này phải được set cho Cloudflare Worker (wrangler secret put OCR_CALLBACK_SECRET)
OCR_CALLBACK_SECRET=<generate: openssl rand -hex 32>
OCR_R2_BUCKET=law-ai-rag-ocr

# ====== RAG tuning ======
RAG_CANDIDATE_K=50
RAG_TOP_K=5
RAG_FUSION_K=60
RAG_HISTORY_TURNS=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_MIN_COSINE_SCORE=0.35
# Comma-separated, empty = no filter
RAG_ALLOWED_BUCKETS=

# ====== Frontend env (NEXT_PUBLIC_*) ======
# NEXTAUTH_SECRET phải GIỐNG JWT_SECRET ở trên
NEXTAUTH_SECRET=<cùng giá trị với JWT_SECRET>
NEXTAUTH_URL=https://ilaw.io.vn
NEXT_PUBLIC_API_URL=https://ilaw.io.vn
NEXT_PUBLIC_APP_URL=https://ilaw.io.vn
