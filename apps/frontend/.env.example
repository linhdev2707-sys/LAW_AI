# ====== Frontend env (copy to .env.local) ======
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js — PHẢI GIỐNG JWT_SECRET bên BE
NEXTAUTH_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
NEXTAUTH_URL=http://localhost:3000

# ====== Google Analytics ======
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Looker Studio or GA4 Embed URL for admin dashboard (optional)
NEXT_PUBLIC_GA_EMBED_URL=

