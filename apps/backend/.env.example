# ====== Backend env (copy to .env) ======
NODE_ENV=development
BACKEND_PORT=4000

# ====== Postgres (must match docker-compose) ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lawai
POSTGRES_PASSWORD=lawai_password
POSTGRES_DB=law_ai
# Aliases for backend code (which reads DATABASE_*)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=lawai
DATABASE_PASSWORD=lawai_password
DATABASE_NAME=law_ai

# ====== JWT (MUST equal NEXTAUTH_SECRET on FE) ======
JWT_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-secret-key-change-me-min-32-chars-bbbbbbb
JWT_REFRESH_EXPIRES_IN=7d

# ====== CORS ======
CORS_ORIGIN=http://localhost:3000
