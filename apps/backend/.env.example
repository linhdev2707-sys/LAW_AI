# ====== Backend env (copy to .env) ======
NODE_ENV=development
BACKEND_PORT=4000

# ====== Postgres (must match docker-compose) ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=lawai
POSTGRES_PASSWORD=lawai_password
POSTGRES_DB=law_ai
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=lawai
DATABASE_PASSWORD=lawai_password
DATABASE_NAME=law_ai

# ====== JWT (MUST equal NEXTAUTH_SECRET on FE) ======
JWT_SECRET=super-secret-key-change-me-min-32-chars-long-aaaaaa
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-secret-key-change-me-min-32-chars-bbbbbbb
JWT_REFRESH_EXPIRES_IN=7d

# ====== CORS ======
CORS_ORIGIN=http://localhost:3000

# ====== LLM (DeepSeek — generation only) ======
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.3

# ====== Embeddings (OpenAI — DeepSeek has no embedding endpoint) ======
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ====== Cloudflare R2 (S3-compatible) ======
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=law-ai-rag
R2_REGION=auto
R2_ENDPOINT=

# ====== OCR (Cloudflare Workers AI) ======
# HMAC shared secret between the ocr-worker and the backend callback.
# Generate locally with: openssl rand -hex 32
OCR_CALLBACK_SECRET=
# Bucket the Worker reads from. The backend uploads raw PDFs to this
# bucket under the prefix `ocr-inbox/`.
OCR_R2_BUCKET=law-ai-rag-ocr

# ====== RAG index / retrieval ======
RAG_CANDIDATE_K=50
RAG_TOP_K=5
RAG_FUSION_K=60
RAG_HISTORY_TURNS=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# ====== Google Analytics (GA4 Data API) ======
GA_PROPERTY_ID=8561970700
GA_CLIENT_EMAIL=ilaw-analytics@gen-lang-client-0787063600.iam.gserviceaccount.com
